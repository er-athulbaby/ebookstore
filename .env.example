APP_NAME="RedCherry Books"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# For local dev on Windows without MySQL installed, switch to:
#   DB_CONNECTION=sqlite
#   DB_DATABASE=/absolute/path/to/database/database.sqlite
# and comment out the DB_HOST..DB_PASSWORD lines below.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# Reuse DB connections between requests (needed on Hostinger: max_connections_per_hour)
DB_PERSISTENT=true
DB_PORT=3306
DB_DATABASE=redcherry
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="orders@redcherrybooks.example"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

# Razorpay — https://dashboard.razorpay.com/app/keys (use test keys until you go live)
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Store settings
STORE_CURRENCY=INR
STORE_CURRENCY_SYMBOL=₹
FREE_DELIVERY_THRESHOLD=799
FLAT_SHIPPING_FEE=60
RETURN_WINDOW_DAYS=7
EBOOK_DOWNLOAD_LIMIT=5
EBOOK_DOWNLOAD_LINK_MINUTES=30
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=support@redcherrybooks.example
SUPPORT_PHONE=

# Testing only: allow Cash on Delivery for eBook orders
COD_FOR_EBOOKS=false
